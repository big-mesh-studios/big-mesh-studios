{
  "name": "@big-mesh-studios/bms-voxelscape",
  "version": "0.1.3",
  "description": "",
  "main": "./dist-lib/lib.umd.js",
  "module": "./dist-lib/lib.es.js",
  "types": "./dist-lib/lib.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/big-mesh-studios/big-mesh-studios.git",
    "directory": "apps/voxelscape"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/lib.d.ts",
      "import": "./dist-lib/lib.es.js",
      "require": "./dist-lib/lib.umd.js"
    }
  },
  "files": [
    "dist-lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:bench": "vite build --mode bench",
    "build-lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json",
    "serve": "vite preview",
    "serve:bench": "vite preview --mode bench",
    "test": "vitest run",
    "bench": "node --experimental-transform-types e2e/bench/run.ts",
    "bench:compare": "node --experimental-transform-types e2e/bench/compare.ts",
    "bench:ab": "node --experimental-transform-types e2e/bench/ab.ts",
    "bench:html": "node --experimental-transform-types e2e/bench/html.ts",
    "check-types": "tsc --noEmit",
    "architecture": "node --experimental-transform-types tools/architecture.ts",
    "architecture:check": "node --experimental-transform-types tools/architecture.ts --check",
    "place-reference": "node --experimental-transform-types tools/place-reference.ts",
    "place-reference:check": "node --experimental-transform-types tools/place-reference.ts --check",
    "rendering": "node --experimental-transform-types tools/voxel-rendering.ts",
    "rendering:check": "node --experimental-transform-types tools/voxel-rendering.ts --check"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@big-mesh-studios/atproto": "workspace:*",
    "@big-mesh-studios/maths": "workspace:*",
    "@big-mesh-studios/place-reference": "workspace:*",
    "@big-mesh-studios/stacker": "workspace:*",
    "@big-mesh-studios/utils": "workspace:*",
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "playwright": "^1.62.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@atcute/atproto": "catalog:",
    "@atcute/client": "catalog:",
    "@atcute/identity-resolver": "catalog:",
    "@atcute/lexicons": "catalog:",
    "@atcute/oauth-browser-client": "catalog:",
    "@big-mesh-studios/code-mirror": "workspace:*",
    "@fortawesome/fontawesome-free": "catalog:",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@random-mesh/rmsl": "catalog:",
    "@solidjs/router": "2.0.0-next.13",
    "@solidjs/signals": "catalog:",
    "@solidjs/web": "catalog:",
    "browser-fs-access": "catalog:",
    "fast-png": "catalog:",
    "jszip": "catalog:",
    "peerjs": "^1.5.5",
    "quickjs-emscripten-core": "0.32.0",
    "solid-js": "catalog:",
    "three": "catalog:"
  }
}
