---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='26' font-size='26'>🧊</text></svg>"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f4f2;
    --panel: #ffffff;
    --ink: #16161a;
    --muted: #5c5c66;
    --line: #dededa;
    --shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 8px 24px rgb(0 0 0 / 0.06);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #101014;
      --panel: #1a1a20;
      --ink: #f0f0ee;
      --muted: #9a9aa6;
      --line: #2a2a33;
      --shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 8px 24px rgb(0 0 0 / 0.3);
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
    padding: 4rem 1.5rem;
    background: var(--bg);
    color: var(--ink);
    font:
      16px/1.6 ui-sans-serif,
      system-ui,
      -apple-system,
      "Segoe UI",
      Helvetica,
      Arial,
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }
</style>
