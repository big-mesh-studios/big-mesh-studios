{
  "name": "big-mesh-studios",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:rm-stacker": "pnpm --filter @big-mesh-studios/rm-stacker dev",
    "dev:voxelscape": "pnpm --filter @big-mesh-studios/bms-voxelscape dev",
    "dev:voxel-rigger": "pnpm --filter @big-mesh-studios/voxel-rigger dev",
    "build": "turbo run build",
    "build-lib": "turbo run build-lib",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.5.8"
  }
}
