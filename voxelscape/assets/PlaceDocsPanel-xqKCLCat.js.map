        {
          "name": "id",
          "type": "number",
          "optional": false,
          "doc": ""
        }
      ]
    },
    {
      "kind": "surface",
      "doc": "A skin over the terrain: the top `depth` voxels of every column in the footprint are replaced with `id`. Without a `level` it follows whatever height the generated terrain reached there, which is how a place paints a desert floor or a grass plain without knowing the height in advance. With a `level` it grades instead: every column's top is brought to that flat voxel, filling the air below it and cutting the terrain above it, so a road runs level through hills and hollows. A `reach` of `\"infinite\"` on an axis extends the footprint across every streamed chunk on that axis.",
      "fields": [
        {
          "name": "min",
          "type": "Voxel3",
          "optional": true,
          "doc": "The footprint's corners, in LOD-0 voxels, required on an axis bounded by `reach` and ignored on an infinite one. y is ignored by the paint and only widens the region a plan change refills."
        },
        {
          "name": "max",
          "type": "Voxel3",
          "optional": true,
          "doc": ""
        },
        {
          "name": "reachX",
          "type": "SurfaceReach",
          "optional": true,
          "doc": "How far the x axis reaches; defaults to `\"bounds\"`."
        },
        {
          "name": "reachZ",
          "type": "SurfaceReach",
          "optional": true,
          "doc": "How far the z axis reaches; defaults to `\"bounds\"`."
        },
        {
          "name": "level",
          "type": "number",
          "optional": true,
          "doc": "The flat LOD-0 voxel top every column is graded to. Absent, the surface follows the terrain height instead."
        },
        {
          "name": "depth",
          "type": "number",
          "optional": false,
          "doc": "How many voxels below each column's top surface to replace."
        },
        {
          "name": "id",
          "type": "number",
          "optional": false,
          "doc": ""
        }
      ]
    }
  ],
