          "type": "Readonly<Record<string, AttributeValue>>",
          "optional": false,
          "doc": "Values the script hangs on this figure under a name."
        },
        {
          "name": "setAttribute",
          "type": "NpcHandle<M>",
          "optional": false,
          "doc": "Gives this figure a value under `key`, replacing any it held there, and returns this figure."
        },
        {
          "name": "getAttribute",
          "type": "AttributeValue | undefined",
          "optional": false,
          "doc": "The value this figure holds under `key`, or undefined."
        },
        {
          "name": "addTag",
          "type": "NpcHandle<M>",
          "optional": false,
          "doc": "Names this figure with `tag`, and returns this figure."
        },
        {
          "name": "removeTag",
          "type": "NpcHandle<M>",
          "optional": false,
          "doc": "Takes `tag` off this figure, and returns this figure."
        },
