    {
      "name": "WorldQuery",
      "doc": "The read side of the world, as a set of functions. Each is written to be a pure function of the shared clock and the replicated state, so every peer's script reads the same world at the same moment.",
      "members": [
        {
          "name": "getNow",
          "type": "number",
          "optional": false,
          "doc": "The shared time source for this sandbox, in milliseconds."
        },
        {
          "name": "getEndings",
          "type": "string[]",
          "optional": false,
          "doc": "Every ending this place has defined."
        },
        {
          "name": "getHeightAt",
          "type": "number",
          "optional": false,
          "doc": "The terrain surface at (`x`, `z`)."
        },
        {
          "name": "getSolidAt",
          "type": "boolean",
          "optional": false,
          "doc": "Whether (`x`, `y`, `z`) is inside solid ground."
        },
        {
          "name": "getWaterAt",
          "type": "boolean",
          "optional": false,
          "doc": "Whether (`x`, `y`, `z`) is water."
        },
        {
          "name": "getPlayers",
          "type": "LivePlayer[]",
          "optional": false,
          "doc": "Every player's live position: the local player first, then connected peers."
        },
        {
          "name": "getBlockAt",
          "type": "number",
          "optional": false,
          "doc": "The block id at (`x`, `y`, `z`), or 0 for air."
        },
        {
          "name": "getEntity",
          "type": "EntitySnapshot | null",
          "optional": false,
          "doc": "The scripted figure `id` names, or null when there is none."
        },
        {
          "name": "getEntitiesInBox",
          "type": "EntitySnapshot[]",
          "optional": false,
          "doc": "Every scripted figure in the box `min` to `max`, inclusive, each corner's components smallest first, in id order."
        },
        {
          "name": "getEntitiesInSphere",
          "type": "EntitySnapshot[]",
          "optional": false,
          "doc": "Every scripted figure within `radius` of (`x`, `y`, `z`), in id order."
        },
        {
          "name": "getEntitiesWithTag",
          "type": "EntitySnapshot[]",
          "optional": false,
          "doc": "Every scripted figure carrying `tag`, in id order."
        },
        {
          "name": "getPlayer",
          "type": "LivePlayer | null",
          "optional": false,
          "doc": "The player `did` names, or null when they are not in the place."
        },
        {
          "name": "getPlayersInBox",
          "type": "LivePlayer[]",
          "optional": false,
          "doc": "Every player in the box `min` to `max`, inclusive, in the order `getPlayers` gives."
        },
        {
          "name": "getLocalPlayer",
          "type": "string",
          "optional": false,
          "doc": "The DID of the player on this peer, or \"\" when they are not signed in."
        },
        {
          "name": "getInput",
          "type": "LocalInput | null",
          "optional": false,
          "doc": "The local player's held movement and tool input, or null where the world reports none."
        },
        {
          "name": "getPlayerValue",
          "type": "number | null",
          "optional": false,
          "doc": "The value the script set for `did` under `key`, or null when there is none."
        },
        {
          "name": "getData",
          "type": "DataValue | undefined",
          "optional": false,
          "doc": "The value the place remembers under `scope`/`key` for `player`, or undefined."
        },
        {
          "name": "getDataLeaderboard",
          "type": "{ player: string; value: DataValue; }[]",
          "optional": false,
          "doc": "The players ranked by a remembered `key`, highest first, ties by player, at most `count`."
        },
        {
          "name": "getLeaderboard",
          "type": "LeaderboardEntry[]",
          "optional": false,
          "doc": "The players ranked by `key`, highest first, ties by player string, at most `count` of them."
        },
        {
          "name": "raycast",
          "type": "RaycastHit | null",
          "optional": false,
          "doc": "Where a ray from `origin` along `direction` first meets the world, or null within `maxDistance` world units."
        },
        {
          "name": "findPath",
          "type": "[number, number, number][] | null",
          "optional": false,
          "doc": "The walkable route from `from` to `to`, as world-unit waypoints, or null when none exists within the bounds."
        }
      ],
