  "effects": [
    {
      "name": "Figures",
      "doc": "NPCs, props, and everything hung on them or standing in one of their zones.",
      "effects": [
        {
          "tag": "npc",
          "doc": "Stands an NPC, a scripted figure wearing one of the place's models.",
          "fields": [
            {
              "name": "id",
              "type": "string",
              "optional": false,
              "doc": ""
            },
            {
              "name": "x",
              "type": "number",
              "optional": false,
              "doc": "The NPC's feet, in world units; the host grounds the figure's height."
            },
            {
              "name": "z",
              "type": "number",
              "optional": false,
              "doc": ""
            },
            {
              "name": "y",
              "type": "number",
              "optional": true,
              "doc": "The NPC's feet height in world units; defaults to the ground."
            },
            {
              "name": "name",
              "type": "string",
              "optional": true,
              "doc": ""
            },
            {
              "name": "model",
              "type": "string",
              "optional": true,
              "doc": "The place model file the NPC wears; the world picks one when absent."
            },
            {
              "name": "modelUri",
              "type": "string",
              "optional": true,
              "doc": "The NPC's model, read live from its own `at://` address instead of the place's bundled files — takes precedence over `model` when set."
            },
            {
              "name": "yaw",
              "type": "number",
              "optional": true,
              "doc": "Heading in radians, turning the figure to face somewhere."
            },
            {
              "name": "live",
              "type": "boolean",
              "optional": true,
              "doc": "Marks this update as the position a script has computed itself as the entity's current owner, to be broadcast to other peers rather than left for each of them to compute independently. Absent or false means the position is left to each peer's own deterministic replay, the way every other NPC already works."
            },
            {
              "name": "motion",
              "type": "MotionSpec",
              "optional": true,
              "doc": "A path and spin the NPC follows over the shared clock."
            },
            {
