    {
      "kind": "ramp",
      "doc": "A solid incline from one point to another, its top stepping one voxel at a time.",
      "fields": [
        {
          "name": "from",
          "type": "Voxel3",
          "optional": false,
          "doc": "The base of the low end, in LOD-0 voxels."
        },
        {
          "name": "to",
          "type": "Voxel3",
          "optional": false,
          "doc": "The top of the high end."
        },
        {
          "name": "width",
          "type": "number",
          "optional": false,
