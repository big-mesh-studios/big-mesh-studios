          "optional": false,
          "doc": "Walks the figure to a point along a route the world searches for, and returns whether one exists."
        },
        {
          "name": "play",
          "type": "NpcHandle<M>",
          "optional": false,
          "doc": "Plays one of the model's motions, named as the model's file names it."
        },
        {
          "name": "stop",
          "type": "NpcHandle<M>",
          "optional": false,
          "doc": "Stops the NPC's animation, standing it back at rest."
        },
        {
          "name": "setLook",
          "type": "NpcHandle<M>",
          "optional": false,
          "doc": "Tints and fades the NPC over its model's colours."
        },
        {
          "name": "clearLook",
          "type": "NpcHandle<M>",
          "optional": false,
          "doc": "Clears the NPC's tint and fade."
        },
        {
          "name": "remove",
          "type": "void",
          "optional": false,
          "doc": "Removes the NPC outright — no death fall."
        },
        {
          "name": "die",
          "type": "void",
          "optional": false,
